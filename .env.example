# Twitch app (https://dev.twitch.tv/console), configured as a confidential Chat Bot app
TWITCH_CLIENT_ID=
TWITCH_CLIENT_SECRET=
TWITCH_REDIRECT_URI=http://localhost:3000/auth/callback

# Channel the bot joins, and the bot account
BROADCASTER_LOGIN=
BOT_LOGIN=
# Optional comma-separated chat bot logins to exclude from reaction evidence
CHAT_BOT_LOGINS=
# A reaction burst needs this many distinct chatters within the configured seconds
CHAT_BURST_MIN=3
CHAT_BURST_WINDOW_SECONDS=5

# Judge: "keyword" (free, no key) or "openai"
JUDGE_PROVIDER=keyword
OPENAI_API_KEY=

PORT=3000

# Twitch chat permissions are requested in the browser during /auth/bot and /auth/broadcaster.

# The foundation currently uses PORT only. Twitch settings are for later steps.
